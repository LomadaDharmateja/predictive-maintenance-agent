# Security
.env
.env.*
!.env.example
*.pem
*.key
kaggle.json
.kaggle/

# Python Virtual Environment
venv/
.venv/
__pycache__/
*.pyc

# Source data. 77 MB for telemetry alone; committing it would roughly triple the
# repository and could only be undone by rewriting history. Fetch and verify it
# with `make fetch-data`, which checks every file against the SHA-256 constants
# in scripts/fetch_data.py.
data/raw/

# Build outputs. All are rebuilt deterministically by `make data` and
# `make features`.
data/generated/
*.db
*.sqlite3

# ...with two deliberate exceptions, both small and both part of the
# reproducibility record rather than build noise:
#   build_manifest.json  (3 KB) pins the content hash of every table and split,
#                        and is the portable check that a rebuild matched.
#   parts_inventory.csv  (556 B) is the seeded generator's output, committed
#                        alongside the generator so a reader can diff a change
#                        without running it.
!data/generated/build_manifest.json
!data/generated/parts_inventory.csv

# Experiment tracking and model artefacts. Regenerated by `make train`; the
# MLflow run id and data content hash in the manifest are what make a result
# traceable, not the binaries.
mlruns/
mlartifacts/
# Leading slash: root-level only. A bare `models/` also matches src/models/,
# which is source code, and silently kept the training module out of git.
/models/

# Test / tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
