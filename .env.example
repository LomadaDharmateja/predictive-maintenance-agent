# Configuration for the service. Names only -- this file carries no values and
# is the one .env* path .dockerignore deliberately un-excludes.
#
#   cp .env.example .env    then fill it in. .env is gitignored and is excluded
#                           from the Docker build context; `make docker-verify`
#                           builds an image and proves it is absent.
#
# Every name below is read by src/api/config.py, except ANTHROPIC_API_KEY,
# which no code in this repository reads: the Anthropic SDK resolves it itself
# so no line of ours ever holds the value.

# ---- Model provider ----------------------------------------------------
# ollama (local, free, nothing leaves the host) or anthropic (hosted).
PDM_PROVIDER=
# ollama: a pulled tag, e.g. qwen3:4b-q4_K_M
# anthropic: a model id, e.g. claude-sonnet-5
PDM_MODEL=
PDM_OLLAMA_BASE_URL=

# ---- Credentials -------------------------------------------------------
# Only needed when PDM_PROVIDER=anthropic. Never logged, never in an image,
# never read by this repository's own code.
ANTHROPIC_API_KEY=

# ---- Paths -------------------------------------------------------------
# Mounted at runtime, never baked into the image.
PDM_DATABASE=
PDM_RUN_STORE=

# ---- Service behaviour -------------------------------------------------
PDM_MAX_ITERATIONS=
PDM_LOG_LEVEL=
# Turn the OpenAPI page off in anything public-facing.
PDM_ENABLE_DOCS=
