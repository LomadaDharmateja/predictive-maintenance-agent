{
  "name": "industrial-ai-agent",
  // 3.12 to match .github/workflows/pipeline.yml and the local virtualenv.
  // The image was 3.11, which no longer matches anything in the project.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "docs/DATA.md",
        "docs/FEATURES.md"
      ]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  // Was `pip install --user streamlit` plus an unconditional apt upgrade. There
  // is no Streamlit app any more -- the v1 UI is archived -- and installing a
  // package that requirements.txt does not declare is how the two drift apart.
  "onCreateCommand": "pip install --no-cache-dir -r requirements.txt",
  // Was `streamlit run src/app.py`, which now fails: src/app.py moved to
  // archive/v1-app/app.py in Milestone 1. This project has no long-running
  // service to attach to, so nothing is started. The tests that need the Kaggle
  // download will skip until `make fetch-data` has run; the rest execute.
  "postAttachCommand": "pytest -q --no-header || true"
}
